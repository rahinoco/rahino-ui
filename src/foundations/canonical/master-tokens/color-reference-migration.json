{
  "approval": "color-reference-family-step-naming",
  "appliedOn": "2026-10-26",
  "status": "approved-applied",
  "scope": "Master color reference paths and their aliases only. Original foundation exports and all visual values are preserved.",
  "sourceReferences": [
    "https://spectrum.adobe.com/foundations/design-data/design-tokens",
    "https://spectrum.adobe.com/foundations/color/grays"
  ],
  "namingPolicy": {
    "pattern": "ref.color.<hue-family>.<step>; white and black are endpoint names. Transparent siblings append -alpha-<percentage>, e.g. ref.color.plum.500-alpha-12 or ref.color.white-alpha-4.",
    "ordering": "Lower steps are lighter; higher steps are darker within each family. Fixed raw references do not reverse between light and dark themes.",
    "steps": "Sparse Rahino-specific ordinal steps in 25-point increments, inspired by Spectrum family/index naming. They are not Spectrum value matches, lightness percentages, equal perceptual intervals or contrast guarantees. Keep existing IDs stable; allocate unused steps for additions.",
    "alpha": "Alpha is included in the typed color. The suffix describes opacity, not a shade. An alpha-only swatch does not require publishing an unused opaque token.",
    "growth": "Keep current colors and shadow treatments. Add a raw value for a real requirement or an explicitly designed and reviewed scale, rather than speculative combinations."
  },
  "preservedReferenceCount": 124,
  "renamedReferenceCount": 123,
